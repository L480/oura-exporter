# Copy to .env and fill in. .env is gitignored, never commit real values.

# --- Required ------------------------------------------------------------
# Client ID of your application at https://cloud.ouraring.com/oauth/applications
OURA_CLIENT_ID=
# Client secret of that application. Prefer a file (below) over the plain value.
OURA_CLIENT_SECRET=
#OURA_CLIENT_SECRET_FILE=/run/secrets/oura_client_secret

# --- Authorization -------------------------------------------------------
# Must be registered in the Oura application exactly as written here.
#OURA_REDIRECT_URI=http://localhost:8000/callback
# Space-separated scopes.
#OURA_SCOPES=personal daily heartrate spo2 stress
# One-time code (or the full redirect URL) for headless setups. Only used while no
# token is stored; remove it afterwards.
#OURA_AUTH_CODE=
#OURA_AUTH_CODE_FILE=/run/secrets/oura_auth_code
# The data directory (this file's parent) must be writable and used by one instance only.
# The image sets /data/oauth_token.json.
#OURA_TOKEN_PATH=~/.config/oura-exporter/oauth_token.json

# --- Exporter ------------------------------------------------------------
# Seconds between polls, at least 60.
#OURA_POLL_INTERVAL=300
# Replacement for the packaged metric definitions.
#OURA_METRICS_CONFIG=/config/metrics.yml
#OURA_API_BASE_URL=https://api.ouraring.com
#PORT=8000
#LISTEN_ADDRESS=0.0.0.0
# DEBUG, INFO, WARNING, ERROR or CRITICAL.
#LOGLEVEL=INFO
# Used for "today" and the timestamps of daily values. Defaults to UTC in the image.
#TZ=Europe/Berlin

# OURA_ACCESS_TOKEN (personal access tokens) was removed by Oura and is ignored.
