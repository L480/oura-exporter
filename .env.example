# Copy to .env and fill in. .env is gitignored, never commit real values.

# --- Required ------------------------------------------------------------
# Client ID of your application at https://cloud.ouraring.com/oauth/applications
OURA_CLIENT_ID=
# Client secret of that application. Prefer a file (below) over the plain value.
OURA_CLIENT_SECRET=
#OURA_CLIENT_SECRET_FILE=/run/secrets/oura_client_secret
# Prometheus remote write endpoint the samples are pushed to. The receiver needs an
# out-of-order window of at least OURA_LOOKBACK_DAYS (Prometheus: storage.tsdb.out_of_order_time_window).
OURA_REMOTE_WRITE_URL=http://prometheus:9090/api/v1/write

# --- Authorization -------------------------------------------------------
# Must be registered in the Oura application exactly as written here.
#OURA_REDIRECT_URI=http://localhost:8000/callback
# Space-separated scopes.
#OURA_SCOPES=personal daily heartrate spo2 stress workout session tag heart_health ring_configuration
# One-time code (or the full redirect URL) for headless setups. Only used while no
# token is stored; remove it afterwards.
#OURA_AUTH_CODE=
#OURA_AUTH_CODE_FILE=/run/secrets/oura_auth_code
# The data directory (this file's parent) must be writable and used by one instance only.
# The image sets /data/oauth_token.json.
#OURA_TOKEN_PATH=~/.config/oura-exporter/oauth_token.json

# --- Remote write --------------------------------------------------------
# Basic auth of the receiver; set both or neither.
#OURA_REMOTE_WRITE_USERNAME=
#OURA_REMOTE_WRITE_PASSWORD=
#OURA_REMOTE_WRITE_PASSWORD_FILE=/run/secrets/remote_write_password
# Days re-read in every fetch, at least 1. Must not exceed the receiver's out-of-order window.
#OURA_LOOKBACK_DAYS=3

# --- Exporter ------------------------------------------------------------
# Seconds between push cycles, at least 60. Keep it below Prometheus' 5-minute lookback so the
# newest daily values stay current. Cached values are pushed every cycle without API requests.
#OURA_POLL_INTERVAL=120
# Seconds between fetches from the Oura API, at least 60 and not below OURA_POLL_INTERVAL.
#OURA_FETCH_INTERVAL=600
# Replacement for the packaged metric definitions.
#OURA_METRICS_CONFIG=/config/metrics.yml
#OURA_API_BASE_URL=https://api.ouraring.com
#PORT=8000
#LISTEN_ADDRESS=0.0.0.0
# DEBUG, INFO, WARNING, ERROR or CRITICAL.
#LOGLEVEL=INFO
# Decides where a day ends for the daily values. Defaults to UTC in the image.
#TZ=Europe/Berlin
